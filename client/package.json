{
  "name": "traceops-sdk",
  "version": "0.2.0",
  "description": "Incident timeline & root-cause engine SDK for Node.js/Express applications",
  "main": "dist/traceops.js",
  "types": "dist/traceops.d.ts",
  "exports": {
    ".": {
      "require": "./dist/traceops.js",
      "default": "./dist/traceops.js",
      "types": "./dist/traceops.d.ts"
    }
  },
  "files": [
    "dist",
    "traceops.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "observability",
    "monitoring",
    "incident",
    "tracing",
    "root-cause",
    "devops",
    "traceops"
  ],
  "author": "Thee-sage",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Thee-sage/Trace_Ops"
  },
  "homepage": "https://github.com/Thee-sage/Trace_Ops#readme",
  "peerDependencies": {
    "express": "^4.18.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

